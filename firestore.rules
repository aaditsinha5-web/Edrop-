rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'impactScore']) &&
             data.userId == request.auth.uid &&
             data.impactScore is int &&
             data.impactScore >= 0;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                       incoming().impactScore == 0;
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update score or quiz date
        (incoming().diff(existing()).affectedKeys().hasOnly(['impactScore', 'lastQuizAt', 'updatedAt', 'displayName', 'email', 'avatar']))
      );
    }

    // --- Pickup Validation ---
    function isValidPickup(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'count', 'address', 'date', 'timeSlot', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.type is string && data.type.size() <= 200 &&
             data.count is int && data.count >= 0 && data.count < 10000 &&
             data.address is string && data.address.size() <= 1000 &&
             data.date is string && data.date.size() <= 100 &&
             data.timeSlot is string && data.timeSlot.size() <= 100 &&
             data.status in ['scheduled', 'in-progress', 'completed', 'cancelled'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /pickups/{pickupId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidPickup(incoming()) && 
                       isValidId(pickupId) &&
                       incoming().id == pickupId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
                       isValidPickup(incoming()) && (
                         // Action: Cancel
                         (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         // Action: Edit details (if not completed)
                         (existing().status == 'scheduled' && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'count', 'address', 'date', 'timeSlot', 'updatedAt']))
                       ) &&
                       incoming().userId == existing().userId &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
    }
  }
}
