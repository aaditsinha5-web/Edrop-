{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and score",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "impactScore": { "type": "integer" },
        "lastQuizAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "impactScore"]
    },
    "Pickup": {
      "title": "Pickup",
      "description": "Electronic waste pickup request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "count": { "type": "integer" },
        "address": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "in-progress", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "count", "address", "date", "timeSlot", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/pickups/{pickupId}": {
      "schema": "Pickup",
      "description": "Global pickup collection (secured by userId)"
    }
  }
}
